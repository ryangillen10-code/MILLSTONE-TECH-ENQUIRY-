<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enquire | Millstone-Tech</title>
    <style>
        :root {
            --navy: #1E2430;
            --gold: #D4AF37;
            --gold-light: #F0D76C;
            --gold-dark: #B8860B;
            --text-light: #E8E6D9;
            --white: #FFFFFF;
            --input-bg: #2A303F;
            --success: #4ADE80;
            --error: #F87171;
        }
        * {margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',Roboto,sans-serif;}
        body {
            background: var(--navy);
            min-height:100vh;
            padding:2rem 1rem;
            background-image: radial-gradient(circle at top, rgba(212,175,55,0.08) 0%, transparent 55%);
        }
        .brand-header {text-align:center; margin-bottom:2rem;}
        .logo-container {display:flex; flex-direction:column; align-items:center;}
        .brand-logo {
            width:180px; height:auto; margin-bottom:1rem;
            filter:drop-shadow(0 0 12px rgba(212,175,55,0.25));
            border-radius:50%;
        }
        .brand-name {font-size:1.8rem; font-weight:700; color:var(--gold); letter-spacing:1px;}
        .container {
            max-width:600px; margin:0 auto; background:rgba(30,36,48,0.9);
            border-radius:16px; border:1px solid rgba(212,175,55,0.25);
            box-shadow:0 8px 32px rgba(0,0,0,0.35); padding:2.5rem;
        }
        h1 {color:var(--gold); text-align:center; margin-bottom:0.5rem; font-size:1.7rem;}
        .intro {text-align:center; color:var(--text-light); margin-bottom:2rem; opacity:0.85; line-height:1.6;}
        .form-group {margin-bottom:1.5rem;}
        label {display:block; margin-bottom:0.5rem; color:var(--gold-light); font-weight:600;}
        input, textarea {
            width:100%; padding:0.95rem 1.1rem; border:1px solid rgba(212,175,55,0.3);
            border-radius:10px; font-size:1rem; background:var(--input-bg); color:var(--white);
            transition:all 0.3s ease;
        }
        input::placeholder, textarea::placeholder {color:rgba(232,230,217,0.4);}
        input:focus, textarea:focus {
            outline:none; border-color:var(--gold);
            box-shadow:0 0 0 3px rgba(212,175,55,0.15), 0 0 15px rgba(212,175,55,0.1);
        }
        textarea {min-height:160px; resize:vertical;}
        button {
            width:100%; background:linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
            color:var(--navy); border:none; padding:1.1rem; border-radius:10px;
            font-size:1.05rem; font-weight:700; cursor:pointer; transition:all 0.3s ease;
        }
        button:hover {transform:translateY(-2px); box-shadow:0 6px 20px rgba(212,175,55,0.35);}
        button:disabled {opacity:0.6; cursor:not-allowed; transform:none; box-shadow:none;}
        .status {margin-top:1.5rem; padding:1.2rem; border-radius:10px; display:none; text-align:center; font-weight:500;}
        .success {background:rgba(74,222,128,0.1); color:var(--success); border:1px solid rgba(74,222,128,0.3);}
        .error {background:rgba(248,113,113,0.1); color:var(--error); border:1px solid rgba(248,113,113,0.3);}
        @media (max-width:480px) {
            .container {padding:1.75rem 1.25rem;}
            .brand-name {font-size:1.5rem;}
            .brand-logo {width:140px;}
        }
    </style>
</head>
<body>
    <div class="brand-header">
        <div class="logo-container">
            <!-- Paste your logo file here -->
            <img src="https://i.imgur.com/REPLACE-THIS.png" alt="Millstone-Tech" class="brand-logo">
            <h1 class="brand-name">Millstone-Tech</h1>
        </div>
    </div>

    <div class="container">
        <h1>Get In Touch</h1>
        <p class="intro">Have a project or question? Send us your details and we'll get back to you promptly.</p>

        <form id="enquiryForm">
            <div class="form-group">
                <label for="name">Your Full Name *</label>
                <input type="text" id="name" required placeholder="Enter your full name">
            </div>
            <div class="form-group">
                <label for="email">Email Address *</label>
                <input type="email" id="email" required placeholder="your@email.com">
            </div>
            <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" placeholder="Your contact number">
            </div>
            <div class="form-group">
                <label for="subject">Subject *</label>
                <input type="text" id="subject" required placeholder="e.g. Network Installation">
            </div>
            <div class="form-group">
                <label for="message">Your Message *</label>
                <textarea id="message" required placeholder="Tell us about your requirements..."></textarea>
            </div>
            <button type="submit" id="submitBtn">Send Enquiry</button>
            <div id="statusMsg" class="status"></div>
        </form>
    </div>

    <script>
        const form = document.getElementById('enquiryForm');
        form.addEventListener('submit', e => {
            e.preventDefault();
            const name = document.getElementById('name').value.trim();
            const email = document.getElementById('email').value.trim();
            const phone = document.getElementById('phone').value.trim() || 'Not provided';
            const subject = document.getElementById('subject').value.trim();
            const message = document.getElementById('message').value.trim();

            const emailBody = `
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
     MILLSTONE-TECH ENQUIRY
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Name: ${name}
Email: ${email}
Phone: ${phone}
Subject: ${subject}

Message:
${message}

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
Submitted via GitHub Pages
            `;

            // 👇 UPDATE YOUR EMAIL 👇
            const yourEmail = 'ryangillen10@gmail.com;

            window.location.href = `mailto:${yourEmail}?subject=Enquiry — ${encodeURIComponent(subject)}&body=${encodeURIComponent(emailBody)}`;
            
            document.getElementById('statusMsg').className = 'status success';
            document.getElementById('statusMsg').style.display = 'block';
            document.getElementById('statusMsg').textContent = '✅ Email opened — press SEND to submit!';
            
            setTimeout(() => {form.reset(); document.getElementById('statusMsg').style.display = 'none';}, 8000);
        });
    </script>
</body>
</html>
